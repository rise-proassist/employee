#Options +FollowSymLinks
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule !\.(pdf|ico|gif|jpg|png|css|html|xml)$ index.php
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

AuthUserFile /home/users/1/lolipop.jp-dp34158915/web/chiba-chikusan/conf/.htpasswd
#AuthGroupFile /dev/null
#AuthName "Input ID and Password."
#AuthType Basic
#require valid-user
